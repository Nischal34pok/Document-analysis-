# GEMINI_API_KEY: Required for Gemini AI API calls (Online mode & cloud embeddings).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies.
# Auto-generated securely in memory/SQLite if omitted in local development.
SESSION_SECRET="change-me-in-production"

# OLLAMA_BASE_URL: Default local Ollama server URL for Offline AI mode.
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# SQLITE_DB_PATH: Optional custom path for the SQLite database file.
SQLITE_DB_PATH="./data/documind.db"
